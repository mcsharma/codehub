{
  "name": "codehub",
  "private": true,
  "type": "module",
  "description": "AI-first GitHub competitor",
  "scripts": {
    "typecheck": "pnpm --filter @codehub/bff typecheck && pnpm --filter @codehub/frontend typecheck",
    "dev": "concurrently \"pnpm run --filter @codehub/bff dev\" \"pnpm run --filter @codehub/frontend dev\" \"pnpm run --filter @codehub/frontend relay\"",
    "build": "pnpm run -r build",
    "db:migrate": "pnpm --filter @codehub/bff migrate",
    "db:generate": "pnpm --filter @codehub/bff generate",
    "relay": "pnpm --filter @codehub/frontend relay",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-relay": "^2.0.0",
    "globals": "^17.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
