// bff/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

generator pothos {
  provider      = "prisma-pothos-types"
  output        = "../src/__generated__/pothos-prisma-types.ts"
  clientOutput  = "../../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
}

model ModelUser {
  id                BigInt       @id @default(autoincrement())
  createdTime       DateTime     @default(now()) @map("created_time")
  updatedTime       DateTime     @updatedAt      @map("updated_time")
  isDeleted         Boolean      @default(false)  @map("is_deleted")
  username          String       @unique         @map("username")
  data              Json         @map("data")

  adminOfOrganizations ModelOrganization[] @relation("OrganizationAdmins")

  ownedRepositories    Repository[] @relation("RepositoryOwner")
  adminOfRepositories  Repository[] @relation("RepositoryAdmins")
  commitsAuthored   Commit[]     @relation("CommitAuthor")
  @@map("users")
}

model ModelOrganization {
  id                BigInt       @id @default(autoincrement())
  createdTime       DateTime     @default(now()) @map("created_time")
  updatedTime       DateTime     @updatedAt      @map("updated_time")
  isDeleted         Boolean      @default(false)  @map("is_deleted")
  name              String       @unique         @map("name")
  data              Json         @map("data")

  repositories      Repository[] @relation("OrganizationRepositories")
  admins            ModelUser[]  @relation("OrganizationAdmins")
  @@map("organizations")
}

enum RepositoryVisibility {
  PUBLIC
  PRIVATE
}

model Repository {
  id                  BigInt             @id @default(autoincrement())
  createdTime         DateTime           @default(now()) @map("created_time")
  updatedTime         DateTime           @updatedAt      @map("updated_time")
  isDeleted           Boolean            @default(false)  @map("is_deleted")
  name                String             @map("name")
  visibility          RepositoryVisibility @default(PUBLIC) @map("visibility")

  ownerUserId         BigInt?            @map("owner_user_id")
  ownerUser           ModelUser?         @relation("RepositoryOwner", fields: [ownerUserId], references: [id])

  ownerOrganizationId BigInt?            @map("owner_organization_id")
  ownerOrganization   ModelOrganization? @relation("OrganizationRepositories", fields: [ownerOrganizationId], references: [id])

  admins              ModelUser[]  @relation("RepositoryAdmins")
  commits             Commit[]

  @@unique([ownerUserId, name])
  @@unique([ownerOrganizationId, name])
  @@map("repositories")
}

model Commit {
  id           BigInt     @id @default(autoincrement())
  createdTime  DateTime   @default(now()) @map("created_time")
  repositoryId BigInt     @map("repository_id")
  repository   Repository @relation(fields: [repositoryId], references: [id])
  sha          String     @map("sha")
  message      String?    @map("message")
  authorId     BigInt?    @map("author_id")
  author       ModelUser? @relation("CommitAuthor", fields: [authorId], references: [id])
  @@unique([repositoryId, sha])
  @@map("commits")
}
