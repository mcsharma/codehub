{
  "name": "@codehub/frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"pnpm run typecheck:watch\"",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput --pretty",
    "typecheck": "relay-compiler && tsc --noEmit",
    "build": "tsc && relay-compiler && vite build",
    "preview": "vite preview",
    "relay": "relay-compiler --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-relay": "^20.1.1",
    "react-router": "^8.2.0",
    "relay-runtime": "^20.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-relay": "^18.2.1",
    "@types/relay-runtime": "^20.1.1",
    "@vitejs/plugin-react": "^5.1.4",
    "relay-compiler": "^20.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-relay": "^2.1.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "relay": {
    "src": "./src",
    "schema": "../bff/src/__generated__/schema.graphql",
    "language": "typescript",
    "eagerEsModules": true
  }
}
