# frontend/.env.example
# Copy to .env.local for local overrides.

# Host the Clone dropdown builds its `hg clone` command against. Leave
# unset to use prod's hg.greensnippet.com; set to localhost:8000 for local
# dev against the local hgweb (see services/hg/README.md "Local dev"
# section).
VITE_HG_HOST=
