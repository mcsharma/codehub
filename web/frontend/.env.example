# frontend/.env.example
# Copy to .env.local for local overrides.

# Host the Clone dropdown builds its `hg clone` command against. Leave
# unset to use prod's hg.greensnippet.com; set to the VM's test hgweb-proxy
# (e.g. <vm-ip>:8001) for local dev (see services/hg/README.md "Local dev"
# section).
VITE_HG_HOST=
