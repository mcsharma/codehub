# frontend/.env.example
# Copy to .env.local for local overrides.

# Hosts the Clone dropdown builds its `hg clone`/`git clone` command
# against. Leave unset to use prod (hg.greensnippet.com /
# git.greensnippet.com:8443); set to the VM's test-stack proxies (e.g.
# <vm-ip>:8001 / <vm-ip>:8002) for local dev (see services/hg/README.md and
# services/git/README.md "Local dev"/test sections).
VITE_HG_HOST=
VITE_GIT_HOST=
