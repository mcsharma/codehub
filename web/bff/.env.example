# bff/.env.example
# Copy to .env and set your DATABASE_URL — points at the "test" Railway
# Postgres service for local dev, the "prod" one in prod. See
# services/hg/README.md for the full local-dev-vs-prod picture.
DATABASE_URL="postgresql://codehub:codehub@localhost:5432/codehub_dev"

# Google OAuth (Login with Google) — from Google Cloud Console > Google Auth
# Platform > Clients. Redirect URI must match exactly what's registered there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:5173/auth/google/callback"

# Shared secret the BFF uses to authenticate its own hgweb JSON requests
# (browsing commits/bookmarks). Same value must be set on Railway.
HG_INTERNAL_TOKEN=

# hgweb for whichever environment this BFF is (test in local dev, prod in
# prod) — both are containerized on the DO VM now (see
# services/hg/README.md), so this always points at a real hgweb, never
# "localhost"/unset.
HG_WEB_BASE="http://143.110.207.184:8001"

# No env var needed here for the VM worker's auth — it authenticates as a
# normal PAT bearer token (see pothos/schema/hg-worker.ts's requireHgWorker,
# and personal_access_token.ts), just for a reserved "codehub-hg-worker"
# service-account user seeded once per environment
# (scripts/seed-hg-worker.mjs). The resulting raw token goes into the VM
# worker's own env (services/hg/worker/.env's HG_WORKER_TOKEN), not here.
