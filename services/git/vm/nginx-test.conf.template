# Test stack's nginx — same auth_request/@auth_denied machinery as prod
# (see nginx-prod.conf), but plain HTTP on a bare port (no domain/TLS to
# issue a cert for) and pointed at the test BFF's Railway domain instead of
# git.greensnippet.com's own /internal/auth-check.
#
# A .template (not .conf) mounted at /etc/nginx/templates/ — the official
# nginx:alpine image's entrypoint runs envsubst over every *.template file
# there at container start, substituting only variables actually present in
# the container's own env (BFF_TEST_DOMAIN, set in docker-compose.test.yml),
# so nginx's own $variables pass through untouched (see
# services/hg/vm/nginx-test.conf.template's identical reasoning).
server {
    listen 8002;
    server_name _;

    # git's smart-HTTP protocol, under a two-segment /owner/repo prefix
    # (unlike a typical single-$repo git server) — clone/fetch hits
    # HEAD/info/refs/objects/*/git-upload-pack, push hits git-receive-pack.
    # Commit/diff/directory browsing for git repos — see
    # docs/plans/zesty-zooming-cupcake.md. A real HTTP server (proxy_pass),
    # not fastcgi like git-http-backend below. Ordered first since it's the
    # more specific prefix; matched before falling through to the
    # smart-HTTP location for the same /owner/repo namespace.
    location ~ ^/[^/]+/[^/]+/_browse/ {
        auth_request /internal/auth-check;
        error_page 401 = @auth_denied;

        proxy_pass http://git-browse:9100;
        proxy_set_header Host $host;
    }

    location ~ ^/[^/]+/[^/]+/(HEAD|info/refs|objects/.*|git-upload-pack|git-receive-pack)$ {
        auth_request /internal/auth-check;
        error_page 401 = @auth_denied;
        # Lets post-receive attribute a review to the actual pushing human
        # instead of the git-app container's own service account — see
        # services/git/hooks/post-receive and web/bff/src/index.ts's
        # X-CodeHub-User response header.
        auth_request_set $codehub_user $upstream_http_x_codehub_user;

        include fastcgi_params;
        fastcgi_pass git-app:9000;
        fastcgi_param SCRIPT_FILENAME /usr/lib/git-core/git-http-backend;
        fastcgi_param GIT_PROJECT_ROOT /data/repos;
        fastcgi_param GIT_HTTP_EXPORT_ALL "";
        fastcgi_param PATH_INFO $uri;
        fastcgi_param REMOTE_USER $codehub_user;
    }

    location = /internal/auth-check {
        internal;
        proxy_pass https://${BFF_TEST_DOMAIN}/internal/auth-check;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
    }

    location @auth_denied {
        add_header WWW-Authenticate 'Basic realm="git access"' always;
        return 401;
    }
}
