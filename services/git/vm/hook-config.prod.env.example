# Copy to hook-config.prod.env on the VM (not committed — see root
# .gitignore). Bind-mounted into git-app at /opt/gitservice/hook-config.env,
# sourced by hooks/post-receive — deliberately not a git-app container env
# var, since fcgiwrap's env-passthrough to spawned CGI children isn't
# something to depend on for a secret (see services/git/README.md).
#
# GIT_HOOKS_TOKEN: generate with
#   DATABASE_URL=<prod> node web/bff/scripts/seed-git-hook.mjs
BFF_GRAPHQL_URL=https://www.greensnippet.com/graphql
CODEHUB_WEB_URL=https://www.greensnippet.com
GIT_HOOKS_TOKEN=
