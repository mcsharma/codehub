# Bind-mounted to /etc/gitconfig inside the git-app container — applies to
# every bare repo under /data/repos uniformly, mirroring hgweb.ini's global
# [hooks] section applying to every repo under /data/repos/** (rather than
# templating hooks into each repo individually at `git init` time).
[core]
	hooksPath = /opt/gitservice/hooks

[receive]
	# Reject any push that isn't a fast-forward of the target ref, at the
	# object-database level, before hooks even run — belt-and-suspenders
	# alongside pre-receive's own ref-name enforcement. Bare repos here are
	# never intended to be force-pushed to (reviews/<sha> refs are always
	# newly named, never reused — see cli/src/commands/submit.ts's hg
	# analog and services/git/hooks/pre-receive).
	denyNonFastForwards = true
