#!/usr/bin/env bash
# Pushes may create, update, force-push or delete any ref, except that
# refs/heads/master may only move forward: deleting it or a non-fast-forward
# update (force-push) is rejected. Same policy as services/hg/hg_hooks.py's
# protect_master_bookmark.
#
# A pre-receive hook rejects the *entire* push on any bad ref, so a push that
# also touches other refs fails as a whole.
set -euo pipefail

while read -r old_sha new_sha ref; do
  [[ "$ref" == "refs/heads/master" ]] || continue

  if [[ "$new_sha" =~ ^0+$ ]]; then
    echo "rejected $ref: master cannot be deleted" >&2
    exit 1
  fi
  if [[ "$old_sha" =~ ^0+$ ]]; then
    continue # first push creating master
  fi
  if ! git merge-base --is-ancestor "$old_sha" "$new_sha"; then
    echo "rejected $ref: master can only move forward (non-fast-forward push)" >&2
    exit 1
  fi
done
