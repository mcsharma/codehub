# Test stack's nginx — same auth_request/@auth_denied machinery as prod
# (see nginx-prod.conf), but plain HTTP on a bare port (no domain/TLS to
# issue a cert for, same reasoning nginx-hgweb.local.conf uses for
# localhost) and pointed at the test BFF's Railway domain instead of
# hg.greensnippet.com's own /internal/auth-check.
#
# A .template (not .conf) mounted at /etc/nginx/templates/ — the official
# nginx:alpine image's entrypoint runs envsubst over every *.template file
# there at container start, substituting only variables actually present in
# the container's own env (BFF_TEST_DOMAIN, set in docker-compose.test.yml),
# so nginx's own $host/$request_uri/etc. pass through untouched. Lets the
# test BFF's Railway domain be set at deploy time rather than hand-edited
# into a checked-in file.
server {
    listen 8001;
    server_name _;

    location / {
        auth_request /internal/auth-check;
        error_page 401 = @auth_denied;

        proxy_pass http://hgweb-app:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /internal/auth-check {
        internal;
        proxy_pass https://${BFF_TEST_DOMAIN}/internal/auth-check;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
    }

    location @auth_denied {
        add_header WWW-Authenticate 'Basic realm="hg access"' always;
        return 401;
    }
}
