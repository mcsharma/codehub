{
  "tasks": {
    "dev": "deno run --allow-run=hg --allow-read --allow-write --allow-net --allow-env src/main.ts",
    "check": "deno check src/main.ts",
    "compile": "deno compile --allow-run=hg --allow-read --allow-write --allow-net --allow-env -o dist/ch src/main.ts"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true
  }
}
